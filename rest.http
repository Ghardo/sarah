# Variables for your service
@host = http://raspberrypi.local:7575
@deviceName = backend:libusb:001:002

###
# GET: Hello World
GET {{host}}/

###
# GET: Version
GET {{host}}/version

###
# GET: List devices
# Shows all detected scanners.
GET {{host}}/list

###
# GET: Fetch device configuration
# Shows all options of your scanner (this is where you find the button names).
GET {{host}}/config?device={{deviceName}}

# -----------------------------------------------------
# MANUAL SCANNING
# -----------------------------------------------------

###
# POST: Start a manual scan (A4)
# Runs a single scan *immediately*.
POST {{host}}/scan
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "Options": {
        "mode": "Color",
        "resolution": 300,
        "tl-x": 0.0,
        "tl-y": 0.0,
        "br-x": 210.0,
        "br-y": 297.0
    }
}

###

POST {{host}}/scan
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "Filename": "PreviewScan",
    "Options": {
        "mode": "Color",
        "resolution": 300,
        "tl-x": 0.0,
        "tl-y": 0.0,
        "br-x": 210.0,
        "br-y": 297.0
    }
}

###
# POST: Scan as JPEG (quality 1–100, default 85)
# "Format" is "png" (default) or "jpeg". The extension .png/.jpg is appended to match.
# Works the same way for POST /watch.
POST {{host}}/scan
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "Format": "jpeg",
    "Quality": 80,
    "Options": {
        "mode": "Color",
        "resolution": 300,
        "tl-x": 0.0,
        "tl-y": 0.0,
        "br-x": 210.0,
        "br-y": 297.0
    }
}

# -----------------------------------------------------
# HARDWARE BUTTON WATCHERS
# -----------------------------------------------------

###
# POST: Start watcher 1 (A4)
# Watches the "extra" button. When pressed, an A4 scan is triggered.
POST {{host}}/watch
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "WatchSensor": "extra",
    "Options": {
        "mode": "Color",
        "resolution": 300,
        "tl-x": 0.0,
        "tl-y": 0.0,
        "br-x": 210.0,
        "br-y": 297.0
    }
}

###

POST {{host}}/watch
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "Filename": "file_{doc}_{index}_{date}_{time}",
    "WatchSensor": "file",
    "NewDoc": true,
    "Options": {
        "mode": "Color",
        "resolution": 300,
        "tl-x": 0.0,
        "tl-y": 0.0,
        "br-x": 210.0,
        "br-y": 297.0
    }
}


###


POST {{host}}/watch
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "Filename": "file_{doc}_{index}_{date}_{time}",
    "WatchSensor": "extra",
    "NewDoc": false,
    "Options": {
        "mode": "Color",
        "resolution": 300,
        "tl-x": 0.0,
        "tl-y": 0.0,
        "br-x": 210.0,
        "br-y": 297.0
    }
}

###
# POST: Start watcher 2 (A5)
# Watches the "email" button (example). When pressed, an A5 scan is triggered.
# This one runs in parallel to watcher 1.
POST {{host}}/watch
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "WatchSensor": "email",
    "Options": {
        "mode": "Gray",
        "resolution": 150,
        "tl-x": 0.0,
        "tl-y": 0.0,
        "br-x": 148.0,
        "br-y": 210.0
    }
}

###
# DELETE: Stop ONE watcher
# Stops only the watcher for the "scan" button.
DELETE {{host}}/watch
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "WatchSensor": "scan"
}

###

# GET: List all active watchers
# Shows which "Device:Button" combinations are currently watched.
GET {{host}}/watch/list


###
# DELETE: Stop ALL watchers
# Stops all running watchers at once.
DELETE {{host}}/watch/all

# -----------------------------------------------------
# FETCHING SCANS
# -----------------------------------------------------

###
# GET: Fetch a scanned image
#
# HOW TO:
# 1. Run a manual scan OR press a hardware button.
# 2. Copy the "filename" from the JSON response (e.g. "scan_...png").
# 3. Paste the file name below.
@scanFilename = scan_xxxxxxxx_xxxxxx.png
GET {{host}}/scans/{{scanFilename}}

# -----------------------------------------------------
# POST-PROCESSES
# -----------------------------------------------------

###
# GET: List post-processes
GET {{host}}/post-process

###
# POST: Create a post-process
POST {{host}}/post-process
Content-Type: application/json

{
    "name": "Example",
    "description": "Does nothing",
    "default": true
}

###
# PUT: Upload the file (replaces the existing one)
PUT {{host}}/post-process/example/file
Content-Type: multipart/form-data; boundary=sarah

--sarah
Content-Disposition: form-data; name="file"; filename="post-process.sh"

< ./post-process/post-process.sh
--sarah--

###
# POST: Scan with a specific post-process ("none" = none, field omitted = default)
POST {{host}}/scan
Content-Type: application/json

{
    "Device": "{{deviceName}}",
    "PostProcess": "none",
    "Options": { "mode": "Color", "resolution": 300 }
}
